{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public social profile for an InstaClone user without PII.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Authenticated Firebase UID of the user."
        },
        "username": {
          "type": "string",
          "description": "Lowercase alphanumeric handle (2-30 chars)."
        },
        "displayName": {
          "type": "string",
          "description": "Public display name (1-50 chars)."
        },
        "bio": {
          "type": "string",
          "description": "Short user bio (up to 200 chars)."
        },
        "avatarData": {
          "type": "string",
          "description": "Compressed avatar data URI or HTTPS URL."
        },
        "category": {
          "type": "string",
          "description": "Optional creator category label (up to 50 chars)."
        },
        "pronouns": {
          "type": "string",
          "description": "Optional pronouns label (up to 30 chars)."
        },
        "website": {
          "type": "string",
          "description": "Optional external website URL (up to 200 chars)."
        },
        "followersCount": {
          "type": "integer",
          "description": "Total number of followers."
        },
        "followingCount": {
          "type": "integer",
          "description": "Total number of accounts followed."
        },
        "postsCount": {
          "type": "integer",
          "description": "Total number of posts created."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Profile visibility level."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "userId",
        "username",
        "displayName",
        "bio",
        "avatarData",
        "followersCount",
        "followingCount",
        "postsCount",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "Post": {
      "title": "Post",
      "description": "A photo post shared to the InstaClone feed.",
      "type": "object",
      "properties": {
        "authorId": {
          "type": "string",
          "description": "UID of the post creator."
        },
        "authorUsername": {
          "type": "string",
          "description": "Denormalized username of the creator."
        },
        "authorAvatarData": {
          "type": "string",
          "description": "Denormalized avatar image of the creator."
        },
        "imageData": {
          "type": "string",
          "description": "Compressed JPEG data URI or HTTPS photo URL."
        },
        "caption": {
          "type": "string",
          "description": "Post caption text (up to 2200 chars)."
        },
        "location": {
          "type": "string",
          "description": "Optional location label (empty string if none)."
        },
        "likesCount": {
          "type": "integer",
          "description": "Atomically synchronized count of likes."
        },
        "commentsCount": {
          "type": "integer",
          "description": "Atomically synchronized count of comments."
        },
        "lastCommentId": {
          "type": "string",
          "description": "ID of latest comment for atomic batch verification."
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "private"],
          "description": "Post visibility state."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "authorId",
        "authorUsername",
        "authorAvatarData",
        "imageData",
        "caption",
        "location",
        "likesCount",
        "commentsCount",
        "lastCommentId",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Represents a single user's like on a post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Target post ID."
        },
        "userId": {
          "type": "string",
          "description": "UID of the user liking the post."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["postId", "userId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "A user comment on a post.",
      "type": "object",
      "properties": {
        "postId": {
          "type": "string",
          "description": "Target post ID."
        },
        "authorId": {
          "type": "string",
          "description": "UID of the comment author."
        },
        "authorUsername": {
          "type": "string",
          "description": "Username of the comment author."
        },
        "authorAvatarData": {
          "type": "string",
          "description": "Avatar of the comment author."
        },
        "text": {
          "type": "string",
          "description": "Comment body (1-500 chars)."
        },
        "visibility": {
          "type": "string",
          "enum": ["public"],
          "description": "Comment visibility."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "postId",
        "authorId",
        "authorUsername",
        "authorAvatarData",
        "text",
        "visibility",
        "createdAt"
      ]
    },
    "Follow": {
      "title": "Follow",
      "description": "Directional follow relationship between two users.",
      "type": "object",
      "properties": {
        "followerId": {
          "type": "string",
          "description": "UID of the follower."
        },
        "followingId": {
          "type": "string",
          "description": "UID of the user being followed."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["followerId", "followingId", "createdAt"]
    },
    "Bookmark": {
      "title": "Bookmark",
      "description": "Saved post bookmark owned privately by a user.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "UID of the bookmark owner."
        },
        "postId": {
          "type": "string",
          "description": "Saved post ID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "1-on-1 direct message thread between two users.",
      "type": "object",
      "properties": {
        "participantIds": {
          "type": "array",
          "description": "Sorted two-element array of participant UIDs."
        },
        "userOneId": {
          "type": "string",
          "description": "Lexicographically first participant UID."
        },
        "userOneUsername": {
          "type": "string",
          "description": "Username of first participant."
        },
        "userOneAvatarData": {
          "type": "string",
          "description": "Avatar of first participant."
        },
        "userTwoId": {
          "type": "string",
          "description": "Lexicographically second participant UID."
        },
        "userTwoUsername": {
          "type": "string",
          "description": "Username of second participant."
        },
        "userTwoAvatarData": {
          "type": "string",
          "description": "Avatar of second participant."
        },
        "lastMessage": {
          "type": "string",
          "description": "Preview of most recent message."
        },
        "lastSenderId": {
          "type": "string",
          "description": "UID of most recent message sender."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "participantIds",
        "userOneId",
        "userOneUsername",
        "userOneAvatarData",
        "userTwoId",
        "userTwoUsername",
        "userTwoAvatarData",
        "lastMessage",
        "lastSenderId",
        "createdAt",
        "updatedAt"
      ]
    },
    "DirectMessage": {
      "title": "DirectMessage",
      "description": "Individual chat message inside a 1-on-1 conversation with optional attachment, reply quote, and emoji reactions.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "description": "Parent conversation ID."
        },
        "participantIds": {
          "type": "array",
          "description": "Denormalized two-element array of participant UIDs."
        },
        "senderId": {
          "type": "string",
          "description": "UID of message sender."
        },
        "senderUsername": {
          "type": "string",
          "description": "Username of message sender."
        },
        "text": {
          "type": "string",
          "description": "Message text content (1-1000 chars)."
        },
        "attachmentType": {
          "type": "string",
          "description": "Optional attachment type: '', 'image', 'video', or 'file'."
        },
        "attachmentName": {
          "type": "string",
          "description": "Optional attachment display filename."
        },
        "attachmentSize": {
          "type": "integer",
          "description": "Optional attachment byte size."
        },
        "attachmentData": {
          "type": "string",
          "description": "Optional attachment data URI or preview URL."
        },
        "replyToId": {
          "type": "string",
          "description": "Optional replied-to message ID."
        },
        "replyToSender": {
          "type": "string",
          "description": "Optional replied-to sender username."
        },
        "replyToText": {
          "type": "string",
          "description": "Optional replied-to preview text."
        },
        "reactions": {
          "type": "object",
          "description": "Map of emoji reaction to count."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp set via FieldValue.serverTimestamp()."
        }
      },
      "required": [
        "conversationId",
        "participantIds",
        "senderId",
        "senderUsername",
        "text",
        "createdAt"
      ]
    },
    "Story": {
      "title": "Story",
      "description": "Ephemeral 24-hour photo, video, or gradient text card story.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatarData": { "type": "string" },
        "mediaData": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["image", "video", "text"] },
        "bgGradient": { "type": "string" },
        "overlayText": { "type": "string" },
        "sticker": { "type": "string" },
        "caption": { "type": "string" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "viewsCount": { "type": "integer" },
        "lastCommentId": { "type": "string" },
        "expiresAtMillis": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "authorId",
        "authorUsername",
        "authorAvatarData",
        "mediaData",
        "mediaType",
        "bgGradient",
        "overlayText",
        "sticker",
        "caption",
        "likesCount",
        "commentsCount",
        "viewsCount",
        "lastCommentId",
        "expiresAtMillis",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoryLike": {
      "title": "StoryLike",
      "description": "Single user's like on a story.",
      "type": "object",
      "properties": {
        "storyId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storyId", "userId", "createdAt"]
    },
    "StoryComment": {
      "title": "StoryComment",
      "description": "Comment or quick reply on a story.",
      "type": "object",
      "properties": {
        "storyId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatarData": { "type": "string" },
        "text": { "type": "string" },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "storyId",
        "authorId",
        "authorUsername",
        "authorAvatarData",
        "text",
        "visibility",
        "createdAt"
      ]
    },
    "StoryHighlight": {
      "title": "StoryHighlight",
      "description": "Permanent curated story highlight collection on a user profile.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "coverData": { "type": "string" },
        "storyIds": { "type": "array" },
        "visibility": { "type": "string", "enum": ["public"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "coverData", "storyIds", "visibility", "createdAt"]
    },
    "CallSession": {
      "title": "CallSession",
      "description": "1-on-1 voice or video call signaling session between two users.",
      "type": "object",
      "properties": {
        "callerId": { "type": "string" },
        "callerUsername": { "type": "string" },
        "callerAvatarData": { "type": "string" },
        "calleeId": { "type": "string" },
        "calleeUsername": { "type": "string" },
        "calleeAvatarData": { "type": "string" },
        "participantIds": { "type": "array" },
        "callType": { "type": "string", "enum": ["voice", "video"] },
        "status": { "type": "string", "enum": ["ringing", "active", "ended", "declined", "missed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "callerId",
        "callerUsername",
        "callerAvatarData",
        "calleeId",
        "calleeUsername",
        "calleeAvatarData",
        "participantIds",
        "callType",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/profiles/{userId}": {
      "schema": "UserProfile",
      "description": "Public social profiles without PII."
    },
    "/posts/{postId}": {
      "schema": "Post",
      "description": "Photo posts visible in feed, explore, and profiles."
    },
    "/likes/{likeId}": {
      "schema": "PostLike",
      "description": "Per-user post likes keyed by postId_userId."
    },
    "/comments/{commentId}": {
      "schema": "Comment",
      "description": "Comments attached to posts."
    },
    "/follows/{followId}": {
      "schema": "Follow",
      "description": "Follower-following edges keyed by followerId_followingId."
    },
    "/users/{userId}/bookmarks/{postId}": {
      "schema": "Bookmark",
      "description": "Private saved post bookmarks per user."
    },
    "/conversations/{conversationId}": {
      "schema": "Conversation",
      "description": "1-on-1 direct message threads keyed by userOneId_userTwoId."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": "DirectMessage",
      "description": "Messages inside a direct message thread."
    },
    "/stories/{storyId}": {
      "schema": "Story",
      "description": "24-hour user stories."
    },
    "/story_likes/{likeId}": {
      "schema": "StoryLike",
      "description": "Per-user story likes keyed by storyId_userId."
    },
    "/story_comments/{commentId}": {
      "schema": "StoryComment",
      "description": "Comments and quick replies on stories."
    },
    "/highlights/{highlightId}": {
      "schema": "StoryHighlight",
      "description": "User profile story highlights."
    },
    "/calls/{callId}": {
      "schema": "CallSession",
      "description": "1-on-1 voice/video call signaling sessions."
    }
  }
}
